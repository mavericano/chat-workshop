# Google Gemini API key for chat-service (https://aistudio.google.com/apikey)
GEMINI_API_KEY=PUT_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash-lite

# Encryption of auth headers of MCP servers added in the chat UI (salt must be hex). Changing them makes stored headers unreadable.
# Generate with: openssl rand -hex 32 / openssl rand -hex 8
MCP_SECRETS_KEY=change-me
MCP_SECRETS_SALT=5f2c8a91d4e7b036
# Hosts allowed for MCP servers although they are http or private (comma separated), e.g. servers inside the Docker network
MCP_ALLOWED_HOSTS=
